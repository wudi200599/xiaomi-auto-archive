---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '小米汽车档案馆',
  description = '系统收录小米汽车车型与版本：参数、上市时间、指导价、三电与智驾配置，支持版本级对比。',
} = Astro.props;

const fullTitle = title === '小米汽车档案馆' ? title : `${title} · 小米汽车档案馆`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mi-theme-v2');
          var theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-glow"></div>
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-logo brand-logo-text" aria-hidden="true">MI</span>
          <span class="brand-text">小米汽车档案馆</span>
        </a>
        <div class="header-right">
          <nav class="nav" id="site-nav" aria-label="主导航">
            <a href="/cars" class="nav-link">车型库</a>
            <a href="/timeline" class="nav-link">时间轴</a>
            <a href="/compare" class="nav-link">对比</a>
            <a href="/series" class="nav-link">车系</a>
          </nav>
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-label="打开菜单"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </button>
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="切换主题"
            title="切换白天 / 黑夜"
          >
            <span class="theme-icon theme-icon-sun" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
            </span>
            <span class="theme-icon theme-icon-moon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <div class="brand-text" style="margin-bottom:8px">小米汽车档案馆</div>
          <p class="muted" style="margin:0;font-size:13px">
            本站为小米汽车车型资料整理站，收录车系、版本、参数与代际对比信息。
          </p>
          <p class="muted" style="margin:6px 0 0;font-size:12px;opacity:.75">
            车型图片取自厂商公开发布资料与汽车媒体图库，仅作资料引用。
          </p>
          <p class="muted" style="margin:6px 0 0;font-size:12px;opacity:.75">
            本站为非官方、非商业的车型资料整理项目，与小米集团、小米汽车无隶属或授权关系。产品名称、商标及车型图片归各自权利人所有。
          </p>
        </div>
        <div class="footer-meta mono muted">
          <span>Astro + Vue 3</span>
          <span>·</span>
          <span>数据仅供展示</span>
        </div>
      </div>
    </footer>

    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal-on-scroll').forEach((el) => io.observe(el));

      // Theme toggle
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');

      function currentTheme() {
        return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      }

      function setTheme(theme) {
        root.setAttribute('data-theme', theme);
        try {
          localStorage.setItem('mi-theme-v2', theme);
        } catch (e) {}
        if (btn) {
          btn.setAttribute('aria-label', theme === 'light' ? '切换为黑夜模式' : '切换为白天模式');
        }
      }

      if (btn) {
        setTheme(currentTheme());
        btn.addEventListener('click', () => {
          setTheme(currentTheme() === 'light' ? 'dark' : 'light');
        });
      }

      // Mobile nav
      const navToggle = document.getElementById('nav-toggle');
      const siteNav = document.getElementById('site-nav');
      if (navToggle && siteNav) {
        navToggle.addEventListener('click', () => {
          const open = siteNav.classList.toggle('is-open');
          navToggle.classList.toggle('is-open', open);
          navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          navToggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
        });
        siteNav.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            siteNav.classList.remove('is-open');
            navToggle.classList.remove('is-open');
            navToggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>

    <style is:global>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(20px) saturate(1.2);
        background: var(--header-bg);
        border-bottom: 1px solid var(--line);
        animation: fade-in 0.4s var(--ease-out);
        transition: background-color var(--dur) var(--ease-out), border-color var(--dur);
      }
      .header-glow {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--orange-glow), transparent);
        opacity: 0.8;
        animation: pulse-soft 4s ease-in-out infinite;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 62px;
        position: relative;
        gap: 12px;
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        animation: fade-up 0.5s var(--ease-out);
      }
      .brand-logo {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: #0A0A0A;
        color: #FFFFFF;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        transition: transform var(--dur) var(--ease-spring), box-shadow var(--dur);
      }
      .brand-logo-text {
        font-family: var(--font-display);
        font-size: 14px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.08em;
        padding-left: 0.08em;
      }
      .brand:hover .brand-logo {
        transform: rotate(-6deg) scale(1.06);
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.42);
      }
      .brand-text {
        font-weight: 700;
        letter-spacing: 0.02em;
        font-size: 15px;
      }
      .nav {
        display: flex;
        gap: 4px;
        animation: fade-up 0.5s var(--ease-out) 0.08s both;
      }
      .nav-link {
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
        color: var(--paper-dim);
        transition: color var(--dur-fast), background var(--dur-fast), transform var(--dur-fast);
      }
      .nav-link:hover {
        color: var(--paper);
        background: var(--ink-3);
        transform: translateY(-1px);
      }

      .theme-toggle {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        border: 1px solid var(--line-strong);
        background: var(--ink-2);
        color: var(--paper-dim);
        transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast), transform var(--dur-fast);
      }
      .theme-toggle:hover {
        color: var(--orange);
        border-color: rgba(var(--accent-rgb), 0.45);
        transform: translateY(-1px);
      }
      .theme-icon {
        display: grid;
        place-items: center;
        line-height: 0;
      }
      /* dark shows sun (click to go light), light shows moon */
      [data-theme='dark'] .theme-icon-sun { display: grid; }
      [data-theme='dark'] .theme-icon-moon { display: none; }
      [data-theme='light'] .theme-icon-sun { display: none; }
      [data-theme='light'] .theme-icon-moon { display: grid; }

      .site-footer {
        margin-top: var(--sp-9);
        border-top: 1px solid var(--line);
        padding: var(--sp-7) 0;
        background: linear-gradient(180deg, transparent, var(--ambient-1));
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: var(--sp-5);
        flex-wrap: wrap;
      }
      .footer-meta {
        display: flex;
        gap: 8px;
        font-size: 12px;
        align-items: flex-start;
      }
      @media (max-width: 720px) {
        .header-inner {
          height: 56px;
        }
        .brand-text {
          font-size: 13px;
          max-width: 42vw;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .nav-toggle {
          display: grid;
          place-items: center;
          gap: 4px;
          width: 36px;
          height: 36px;
          border-radius: 10px;
          border: 1px solid var(--line-strong);
          background: var(--ink-2);
          padding: 8px 7px;
          cursor: pointer;
        }
        .nav-toggle-bar {
          display: block;
          width: 16px;
          height: 1.5px;
          background: var(--paper-dim);
          border-radius: 1px;
          transition: transform 0.2s, opacity 0.2s;
        }
        .nav-toggle.is-open .nav-toggle-bar:nth-child(1) {
          transform: translateY(5.5px) rotate(45deg);
        }
        .nav-toggle.is-open .nav-toggle-bar:nth-child(2) {
          opacity: 0;
        }
        .nav-toggle.is-open .nav-toggle-bar:nth-child(3) {
          transform: translateY(-5.5px) rotate(-45deg);
        }
        .nav {
          position: fixed;
          top: 56px;
          left: 0;
          right: 0;
          display: none;
          flex-direction: column;
          gap: 4px;
          padding: 12px 16px 16px;
          background: var(--header-bg);
          backdrop-filter: blur(16px);
          border-bottom: 1px solid var(--line);
          z-index: 49;
        }
        .nav.is-open {
          display: flex;
        }
        .nav-link {
          padding: 12px 14px;
          border-radius: 10px;
          font-size: 14px;
          min-height: 44px;
          display: flex;
          align-items: center;
        }
        .theme-toggle {
          width: 36px;
          height: 36px;
        }
      }
      @media (min-width: 721px) {
        .nav-toggle {
          display: none;
        }
      }
      @media (max-width: 480px) {
        .container {
          width: min(100% - 24px, var(--max));
        }
        .site-footer {
          padding: var(--sp-6) 0 calc(var(--sp-6) + env(safe-area-inset-bottom, 0px));
        }
        .footer-inner {
          flex-direction: column;
          gap: 12px;
        }
      }
    </style>
  </body>
</html>
